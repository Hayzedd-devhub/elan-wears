# =========================================================================
# Per-client deployment config. Copy this file to .env.local (or set these
# as env vars in your hosting provider) and fill in values for THIS client.
# No code changes should be needed to onboard a new client — only env vars
# and, optionally, the /public/logo-main.jpeg and /public/background.jpeg
# files (see "Branding assets" below).
# =========================================================================

# --- Database ---
MONGODB_URI=mongodb://localhost:27017/catalog

# --- Cloudinary (image/video uploads) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Site identity ---
NEXT_PUBLIC_BUSINESS_NAME=Your Business Name
# Full deployed URL, no trailing slash (used for share links, OG tags, manifest).
NEXT_PUBLIC_WEB_URL=https://your-client.vercel.app
# WhatsApp number in international format, digits only, no "+" (used to build wa.me links).
NEXT_PUBLIC_WHATSAPP_NUMBER=2348012345678
# Symbol shown next to prices. Defaults to ₦ if unset.
NEXT_PUBLIC_CURRENCY_SYMBOL=₦

# --- Branding assets (optional) ---
# By default the app uses /public/logo-main.jpeg and /public/background.jpeg.
# For a new client, either:
#   (a) replace those two files in /public before building, or
#   (b) host the images anywhere (e.g. Cloudinary) and point to them here —
#       no rebuild needed to swap images.
# NEXT_PUBLIC_LOGO_URL=https://res.cloudinary.com/your-cloud/logo.png
# NEXT_PUBLIC_BACKGROUND_URL=https://res.cloudinary.com/your-cloud/background.jpg

# --- Hero copy (optional) ---
# NEXT_PUBLIC_HERO_TITLE=Welcome to Our Collection
# NEXT_PUBLIC_HERO_SUBTITLE=Discover quality products, curated just for you.

# --- Theme (optional) ---
# Browser UI / PWA theme color. Page colors themselves live in app/globals.css.
# NEXT_PUBLIC_THEME_COLOR=#2D1210

# Note: admin credentials are NOT set via env vars. The first username/password
# submitted at /admin/login becomes that deployment's permanent admin account.
