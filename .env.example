# =========================================================================
# Per-client deployment config. Copy this file to .env.local (or set these
# as env vars in your hosting provider) and fill in values for THIS client.
# No code changes should be needed to onboard a new client — only env vars
# and, optionally, the /public/logo-main.jpeg, /public/background.jpeg and
# /public/favicon.ico files (see "Branding assets" below).
# =========================================================================

# --- Database ---
MONGODB_URI=mongodb://localhost:27017/catalog

# --- Cloudinary (image/video uploads) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Optional. If this client shares a Cloudinary account with other client
# deployments, set this to namespace their uploads into their own subfolder
# (<CLIENT_ID>/catalog-items) so media doesn't mix. Leave unset for a client
# with its own dedicated Cloudinary account, or to keep using the flat
# "catalog-items" folder pre-existing deployments already use.
# CLIENT_ID=your-client-slug

# --- Site identity ---
NEXT_PUBLIC_BUSINESS_NAME=Your Business Name
# Full deployed URL, no trailing slash (used for share links, OG tags, manifest).
NEXT_PUBLIC_WEB_URL=https://your-client.vercel.app
# WhatsApp number in international format, digits only, no "+" (used to build wa.me links).
NEXT_PUBLIC_WHATSAPP_NUMBER=2348012345678
# Symbol shown next to prices. Defaults to ₦ if unset.
NEXT_PUBLIC_CURRENCY_SYMBOL=₦

# --- Branding assets (optional) ---
# By default the app uses /public/logo-main.jpeg, /public/background.jpeg and
# /public/favicon.ico. For a new client, either:
#   (a) replace those files in /public before building, or
#   (b) host the images anywhere (e.g. Cloudinary) and point to them here —
#       no rebuild needed to swap images.
# NEXT_PUBLIC_LOGO_URL=https://res.cloudinary.com/your-cloud/logo.png
# NEXT_PUBLIC_BACKGROUND_URL=https://res.cloudinary.com/your-cloud/background.jpg
# NEXT_PUBLIC_FAVICON_URL=https://res.cloudinary.com/your-cloud/favicon.png
#
# Logo shape: "landscape" (default) fills a wide bar and crops to fit — for a
# wordmark logo. Set to "square" if the logo is a portrait/square icon or
# monogram, so it's shown in full (contained, not cropped) instead.
# NEXT_PUBLIC_LOGO_ORIENTATION=landscape

# --- Hero copy (optional) ---
# NEXT_PUBLIC_HERO_TITLE=Welcome to Our Collection
# NEXT_PUBLIC_HERO_SUBTITLE=Discover quality products, curated just for you.

# --- Theme (optional) ---
# Overrides the site's actual brand palette (buttons, text, borders — every
# bg-gold/text-chocolate/etc. class), not just browser chrome tint.
# THEME_COLOR is the dark/base color (replaces chocolate), ACCENT_COLOR is the
# highlight color (replaces gold). A lighter shade of each is derived
# automatically. Leave both unset to keep the current gold/chocolate palette.
# NEXT_PUBLIC_THEME_COLOR=#2D1210
# NEXT_PUBLIC_ACCENT_COLOR=#D4AF37

# Note: admin credentials are NOT set via env vars. The first username/password
# submitted at /admin/login becomes that deployment's permanent admin account.
